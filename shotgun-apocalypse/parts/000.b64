<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<meta name="theme-color" content="#090d11">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<title>SHOTGUN APOCALYPSE — REALISM CROSS-PLATFORM</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 64 64%27%3E%3Crect width=%2764%27 height=%2764%27 rx=%2710%27 fill=%27%23080d12%27/%3E%3Ctext x=%279%27 y=%2748%27 font-family=%27Arial%27 font-size=%2740%27 font-weight=%27bold%27 fill=%27%23ff7138%27%3ES%3C/text%3E%3C/svg%3E">
<style>
@import url('https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800;900&family=Rajdhani:wght@400;500;600;700&display=swap');
:root{--orange:#ff7138;--amber:#ffb45c;--red:#ef3d45;--ink:#080d12;--panel:rgba(10,16,22,.88);--line:rgba(174,196,207,.18);--muted:#8a9aa4;--white:#eaf0f2}
*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#080d12;color:var(--white);font-family:'Rajdhani',Arial,sans-serif;user-select:none}canvas{display:block;position:fixed;inset:0;outline:none}
#vignette{position:fixed;inset:0;pointer-events:none;z-index:2;background:radial-gradient(ellipse at center,transparent 42%,rgba(0,0,0,.23) 76%,rgba(0,0,0,.72) 130%)}
#grain{position:fixed;inset:0;z-index:2;pointer-events:none;opacity:.075;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.45'/%3E%3C/svg%3E")}
#hud{position:fixed;inset:0;z-index:5;pointer-events:none;opacity:0;transition:opacity .25s}
.hud-top{position:absolute;left:32px;right:32px;top:25px;display:flex;justify-content:space-between;align-items:flex-start}
.brand-mini{font:800 13px 'Barlow Condensed',sans-serif;letter-spacing:3px;color:#cbd5d9}.brand-mini span{color:var(--orange)}
.wave-block{text-align:center;position:absolute;left:50%;transform:translateX(-50%);top:0}.wave-label{font:700 10px 'Rajdhani';letter-spacing:4px;color:#a4b0b7}.wave-num{font:800 31px 'Barlow Condensed';letter-spacing:2px;line-height:1.05;color:#fff;text-shadow:0 0 18px rgba(255,110,54,.28)}.wave-sub{font:600 10px 'Rajdhani';letter-spacing:2px;color:var(--orange)}
.kills-block{text-align:right}.kills-label{font:700 10px 'Rajdhani';letter-spacing:3px;color:#8998a1}.kills-value{font:800 25px 'Barlow Condensed';color:#f1f4f4;line-height:1}.score-value{font:600 12px 'Rajdhani';color:var(--amber);letter-spacing:1px}
#objective{position:absolute;top:112px;left:50%;transform:translateX(-50%);font:700 11px 'Rajdhani';letter-spacing:2px;color:#c1cbd0;text-shadow:0 2px 8px #000;white-space:nowrap}
#crosshair{position:absolute;left:50%;top:50%;width:28px;height:28px;transform:translate(-50%,-50%);transition:opacity .12s}
.ch{position:absolute;background:rgba(239,245,246,.9);box-shadow:0 0 5px rgba(255,255,255,.3)}.ch.t{width:2px;height:7px;left:13px;top:0}.ch.b{width:2px;height:7px;left:13px;bottom:0}.ch.l{height:2px;width:7px;top:13px;left:0}.ch.r{height:2px;width:7px;top:13px;right:0}.ch.dot{width:3px;height:3px;border-radius:50%;left:12.5px;top:12.5px;background:var(--orange)}
#hitmarker{position:absolute;left:50%;top:50%;width:24px;height:24px;transform:translate(-50%,-50%) rotate(45deg);opacity:0;transition:opacity .08s}.hm{position:absolute;background:#ffb45c}.hm.a{width:2px;height:8px;left:3px;top:0}.hm.b{width:2px;height:8px;right:3px;bottom:0}.hm.c{height:2px;width:8px;left:0;top:3px}.hm.d{height:2px;width:8px;right:0;bottom:3px}
.hud-bottom{position:absolute;left:32px;right:32px;bottom:27px;display:flex;justify-content:space-between;align-items:flex-end}.status-stack{width:210px}.stat-row{display:flex;align-items:center;gap:10px;margin-top:8px}.stat-icon{width:22px;height:22px;border:1px solid rgba(255,255,255,.24);display:grid;place-items:center;color:var(--orange);font:700 11px 'Barlow Condensed';transform:skew(-8deg)}.stat-info{flex:1}.stat-head{display:flex;justify-content:space-between;font:700 10px 'Rajdhani';letter-spacing:2px;color:#b7c2c7}.stat-head b{font:700 13px 'Barlow Condensed';color:#fff}.bar{height:4px;background:rgba(255,255,255,.14);margin-top:4px;overflow:hidden}.bar i{height:100%;display:block;width:100%;background:linear-gradient(90deg,#e24b3e,#ff9854);box-shadow:0 0 10px rgba(255,90,52,.45);transition:width .2s}.armor-bar i{background:linear-gradient(90deg,#4b9bb3,#9cdae5);box-shadow:0 0 10px rgba(90,180,220,.35)}
.weapon-panel{min-width:220px;text-align:right;padding:12px 15px 10px 18px;border-right:2px solid var(--orange);background:linear-gradient(270deg,rgba(12,18,23,.84),rgba(12,18,23,0));clip-path:polygon(8% 0,100% 0,100% 100%,0 100%,0 18%)}.weapon-type{font:700 10px 'Rajdhani';letter-spacing:3px;color:var(--orange)}.weapon-name{font:800 23px 'Barlow Condensed';letter-spacing:1px;color:#fff;line-height:1.05}.ammo-line{font:800 29px 'Barlow Condensed';letter-spacing:2px;color:#fff}.ammo-line small{font:600 15px 'Rajdhani';color:#8e9ba3}.ammo-hint{font:600 9px 'Rajdhani';letter-spacing:2px;color:#7f8c93}
#toast{position:absolute;left:50%;top:68%;transform:translate(-50%,-50%);font:800 18px 'Barlow Condensed';letter-spacing:3px;color:var(--amber);text-shadow:0 2px 10px #000;opacity:0;transition:opacity .2s;white-space:nowrap}
#damage-flash{position:fixed;inset:0;z-index:4;pointer-events:none;opacity:0;background:radial-gradient(ellipse at center,transparent 40%,rgba(220,24,24,.48) 100%);transition:opacity .16s}
#overlay{position:fixed;inset:0;z-index:10;display:flex;align-items:center;justify-content:center;background:linear-gradient(90deg,rgba(4,8,11,.9) 0%,rgba(4,8,11,.58) 48%,rgba(4,8,11,.25) 100%),linear-gradient(0deg,rgba(3,6,9,.65),transparent 55%);transition:opacity .35s,visibility .35s}
#overlay.hidden{opacity:0;visibility:hidden;pointer-events:none}
.menu-wrap{width:min(1120px,92vw);display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:50px;align-items:center;padding:30px 0}.eyebrow{display:flex;align-items:center;gap:12px;color:var(--orange);font:700 11px 'Rajdhani';letter-spacing:4px;margin-bottom:20px}.eyebrow:before{content:'';width:35px;height:2px;background:var(--orange);box-shadow:0 0 12px var(--orange)}
.logo{font:900 clamp(60px,9vw,116px)/.79 'Barlow Condensed',Impact,sans-serif;letter-spacing:-2px;text-transform:uppercase;color:#f4f4ef;text-shadow:0 8px 40px rgba(0,0,0,.5);margin:0}.logo .accent{color:var(--orange);display:block}.tagline{margin:25px 0 29px;color:#aeb9bd;font:600 13px 'Rajdhani';letter-spacing:3px}.menu-actions{display:flex;gap:12px;align-items:center;flex-wrap:wrap}.btn{border:0;cursor:pointer;position:relative;padding:14px 26px;background:var(--orange);color:#111519;font:800 14px 'Barlow Condensed';letter-spacing:2px;text-transform:uppercase;clip-path:polygon(0 0,94% 0,100% 25%,100% 100%,6% 100%,0 75%);transition:transform .16s,filter .16s,background .16s;pointer-events:auto}.btn:hover{transform:translateY(-2px);filter:brightness(1.15);background:#ff915e}.btn:active{transform:translateY(1px)}.btn.secondary{background:rgba(24,34,42,.8);border:1px solid rgba(255,255,255,.22);color:#d9e1e4;clip-path:none}.btn.secondary:hover{background:rgba(49,64,74,.9)}.btn.small{padding:10px 18px;font-size:12px}
.menu-meta{display:flex;gap:25px;margin-top:42px;color:#75848c;font:600 10px 'Rajdhani';letter-spacing:2px}.menu-meta b{color:#c7d0d4;font-weight:700}.side-panel{border-left:1px solid rgba(255,255,255,.16);padding:8px 0 8px 26px}.side-title{font:800 13px 'Barlow Condensed';letter-spacing:3px;color:#e9eff0;margin-bottom:18px}.feature{display:flex;gap:13px;margin:17px 0;align-items:flex-start}.feature .num{font:800 18px 'Barlow Condensed';color:var(--orange);line-height:1}.feature b{display:block;font:700 12px 'Rajdhani';letter-spacing:1.5px;color:#e5ebed}.feature span{display:block;color:#809098;font:500 11px 'Rajdhani';margin-top:3px;line-height:1.3}.side-foot{margin-top:25px;padding-top:17px;border-top:1px solid rgba(255,255,255,.12);font:600 10px 'Rajdhani';letter-spacing:1.4px;color:#829099;line-height:1.7}
.panel-card{width:min(470px,92vw);padding:34px 36px;background:linear-gradient(145deg,rgba(17,26,33,.96),rgba(7,12,17,.97));border:1px solid rgba(255,255,255,.14);box-shadow:0 24px 90px rgba(0,0,0,.55);position:relative}.panel-card:before{content:'';position:absolute;top:-1px;left:28px;width:74px;height:2px;background:var(--orange);box-shadow:0 0 14px var(--orange)}.panel-title{font:900 36px 'Barlow Condensed';letter-spacing:2px;margin:0 0 7px}.panel-sub{font:600 11px 'Rajdhani';letter-spacing:2px;color:#8999a1;margin-bottom:26px}.setting{margin:18px 0}.setting-head{display:flex;justify-content:space-between;font:700 12px 'Rajdhani';letter-spacing:1.5px;color:#d6dfe2;margin-bottom:9px}.setting-head span:last-child{color:var(--orange)}input[type=range]{width:100%;accent-color:var(--orange);cursor:pointer}.panel-actions{display:flex;gap:10px;margin-top:27px;flex-wrap:wrap}.keygrid{display:grid;grid-template-columns:1fr 1fr;gap:10px 20px;margin:18px 0 25px}.keyrow{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid rgba(255,255,255,.08);padding:7px 0;color:#a7b4ba;font:600 12px 'Rajdhani'}.keyrow kbd{font:700 10px 'Rajdhani';color:#f0f2ef;background:#27333b;border:1px solid #40505a;padding:4px 7px;min-width:38px;text-align:center}
#pause-screen,#end-screen,#settings-screen,#controls-screen{position:fixed;inset:0;z-index:12;display:none;align-items:center;justify-content:center;background:rgba(4,8,11,.76);backdrop-filter:blur(9px)}#pause-screen.show,#end-screen.show,#settings-screen.show,#controls-screen.show{display:flex}.end-kicker{font:700 11px 'Rajdhani';letter-spacing:5px;color:var(--orange)}.end-title{font:900 clamp(48px,8vw,78px)/.95 'Barlow Condensed';margin:10px 0 12px}.end-copy{color:#a6b2b8;font:600 13px 'Rajdhani';letter-spacing:1px;margin-bottom:24px}.end-stats{display:flex;gap:24px;margin:24px 0}.end-stats div{border-left:2px solid var(--orange);padding-left:10px}.end-stats b{display:block;font:800 27px 'Barlow Condensed'}.end-stats span{font:700 9px 'Rajdhani';letter-spacing:2px;color:#84949c}
#loading{position:fixed;inset:0;z-index:30;background:#070b0f;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:16px;transition:opacity .5s}.loading-mark{font:900 34px 'Barlow Condensed';letter-spacing:3px}.loading-mark span{color:var(--orange)}.loadbar{width:220px;height:2px;background:#26333a;overflow:hidden}.loadbar i{display:block;height:100%;width:0;background:var(--orange);transition:width .3s}.loadcopy{font:600 9px 'Rajdhani';letter-spacing:3px;color:#72828a}
@media(max-width:760px){.menu-wrap{grid-template-columns:1fr;gap:24px}.side-panel{display:none}.logo{font-size:72px}.menu-meta{margin-top:25px}.hud-top{left:14px;right:14px;top:14px}.hud-bottom{left:14px;right:14px;bottom:14px}.status-stack{width:145px}.weapon-panel{min-width:155px}.weapon-name{font-size:18px}.ammo-line{font-size:23px}.brand-mini{display:none}.wave-block{left:20px;transform:none}.kills-block{margin-left:auto}.panel-card{padding:26px 23px}}

/* Native-feeling landscape mobile overlay. All buttons use Pointer Events and support multitouch. */
html,body{overscroll-behavior:none;-webkit-touch-callout:none}button,input,select{font-family:inherit}
#perf-stats{position:absolute;left:32px;top:85px;font:700 11px 'Rajdhani',sans-serif;letter-spacing:1px;color:#bdc9c8;text-shadow:0 2px 6px #000;font-variant-numeric:tabular-nums}
#perf-stats strong{color:#ffc086}
#touch-ui{position:fixed;inset:0;z-index:7;pointer-events:none;display:none;user-select:none;-webkit-user-select:none}
body.touch-mode.playing #touch-ui{display:block}
#touch-look{position:absolute;right:0;top:0;width:60%;height:100%;touch-action:none;pointer-events:auto}
#joystick{position:absolute;left:max(18px,env(safe-area-inset-left));bottom:max(30px,calc(env(safe-area-inset-bottom) + 18px));width:142px;height:142px;border:2px solid rgba(222,231,237,.22);border-radius:50%;background:radial-gradient(circle,rgba(230,235,237,.11),rgba(15,25,30,.26) 72%);box-shadow:0 0 25px rgba(0,0,0,.25) inset;pointer-events:auto;touch-action:none}
#joystick:after{content:'MOVE';position:absolute;top:-18px;left:42%;font:700 10px 'Rajdhani';letter-spacing:2px;color:#c0c9cd;pointer-events:none}
#stick-knob{position:absolute;width:64px;height:64px;left:50%;top:50%;margin:-32px 0 0 -32px;border-radius:50%;background:linear-gradient(135deg,rgba(255,176,102,.5),rgba(64,79,89,.84));border:2px solid rgba(255,218,175,.52);box-shadow:0 8px 22px #03080b99,0 0 18px #ff713825;transform:translate(0,0);pointer-events:none}
.touch-button{position:absolute;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:3px;border:1px solid rgba(234,242,244,.36);border-radius:50%;background:linear-gradient(160deg,rgba(34,47,53,.78),rgba(9,15,20,.75));box-shadow:0 8px 20px rgba(0,0,0,.35),inset 0 1px 0 #ffffff22;color:#f2f4f3;font:800 13px 'Barlow Condensed',sans-serif;letter-spacing:1px;pointer-events:auto;touch-action:none;user-select:none;-webkit-user-select:none;-webkit-tap-highlight-color:transparent;outline:0}
.touch-button:active,.touch-button.pressed{background:linear-gradient(150deg,#ff8f4a,#ae3f1d);border-color:#ffc69c;transform:scale(.96)}
#touch-fire{right:max(22px,env(safe-area-inset-right));bottom:max(46px,calc(env(safe-area-inset-bottom) + 30px));width:98px;height:98px;border:2px solid rgba(255,161,107,.75);background:radial-gradient(circle at 25% 20%,#d47845d9,#4c2319d9);font-size:17px;box-shadow:0 0 24px #ff713833,inset 0 0 23px #0005}
#touch-aim{right:max(131px,calc(env(safe-area-inset-right) + 128px));bottom:max(48px,calc(env(safe-area-inset-bottom) + 36px));width:65px;height:65px}
#touch-reload{right:max(40px,calc(env(safe-area-inset-right) + 28px));bottom:max(157px,calc(env(safe-area-inset-bottom) + 150px));width:57px;height:57px}
#touch-jump{right:max(114px,calc(env(safe-area-inset-right) + 112px));bottom:max(153px,calc(env(safe-area-inset-bottom) + 145px));width:58px;height:58px}
#touch-sprint{left:max(172px,calc(env(safe-area-inset-left) + 158px));bottom:max(65px,calc(env(safe-area-inset-bottom) + 55px));width:60px;height:60px}
#touch-weapon{right:max(185px,calc(env(safe-area-inset-right) + 177px));bottom:max(50px,calc(env(safe-area-inset-bottom) + 40px));width:58px;height:58px;font-size:11px}
#touch-pause{right:max(14px,env(safe-area-inset-right));top:max(13px,env(safe-area-inset-top));width:45px;height:45px;border-radius:10px;font-size:18px}
#rotate-hint{position:absolute;top:47%;left:50%;transform:translate(-50%,-50%);width:min(80vw,320px);text-align:center;padding:12px 20px;background:#0b131ad9;border:1px solid #ff713866;color:#e7edee;font:800 16px 'Barlow Condensed';letter-spacing:1px;pointer-events:none;display:none}
.quality-select{appearance:none;background:#19242c;color:#edf2f5;border:1px solid #56636b;border-radius:4px;padding:9px 30px 9px 12px;font:700 14px 'Rajdhani';letter-spacing:1px;min-width:160px}
#quality-state{font:600 11px 'Rajdhani';color:#9babb4;margin-top:7px}
@media (pointer:coarse){button,.touch-button{touch-action:manipulation}}
@media(max-width:900px){#perf-stats{left:14px;top:67px;font-size:10px}.menu-wrap{width:min(92vw,600px)}.logo{font-size:clamp(50px,9vw,76px)}.menu-meta{margin-top:19px}.side-panel{display:none}.menu-wrap{grid-template-columns:1fr;gap:10px}.hud-bottom{bottom:max(7px,env(safe-area-inset-bottom));left:12px;right:12px}.weapon-panel{min-width:155px;max-width:175px;padding:7px 9px}.weapon-name{font-size:17px}.ammo-hint{display:none}.status-stack{width:155px;transform:scale(.84);transform-origin:bottom left}.hud-top{top:max(12px,env(safe-area-inset-top));left:15px;right:15px}.wave-block{left:47%;top:0;transform:translateX(-50%)}.kills-value{font-size:19px}#objective{top:75px;font-size:9px;max-width:65vw;overflow:hidden;text-overflow:ellipsis}.panel-card{max-height:90dvh;overflow:auto;padding:18px 21px}.panel-title{font-size:29px}.setting{margin:8px 0}.panel-sub{margin-bottom:10px}}
@media(max-height:480px){#joystick{width:116px;height:116px;bottom:14px}#stick-knob{width:52px;height:52px;margin:-26px 0 0 -26px}#touch-fire{width:78px;height:78px;bottom:15px}#touch-aim{width:53px;height:53px;bottom:20px;right:115px}#touch-weapon{width:47px;height:47px;right:183px;bottom:21px}#touch-reload{width:48px;height:48px;bottom:105px;right:29px}#touch-jump{width:48px;height:48px;bottom:104px;right:100px}#touch-sprint{width:51px;height:51px;left:145px;bottom:30px}.hud-bottom{transform:scale(.76);transform-origin:bottom right}}
@media(orientation:portrait) and (max-width:850px){body.touch-mode.playing #rotate-hint{display:block}#joystick{width:125px;height:125px}#touch-weapon{right:115px;bottom:230px}#touch-pause{z-index:2}}

/* Keep vital stats and ammunition clear of the mobile control buttons. */
body.touch-mode .hud-bottom{position:fixed;inset:0;display:block;transform:none;pointer-events:none}
body.touch-mode .status-stack{position:fixed;left:max(12px,env(safe-area-inset-left));top:max(104px,calc(env(safe-area-inset-top) + 92px));bottom:auto;width:160px;transform:scale(.80);transform-origin:top left;background:linear-gradient(90deg,#071017aa,transparent);padding:4px}
body.touch-mode .weapon-panel{position:fixed;right:max(13px,env(safe-area-inset-right));top:max(102px,calc(env(safe-area-inset-top) + 90px));bottom:auto;min-width:160px;max-width:180px;transform:none;background:linear-gradient(270deg,#071017b8,#07101744);padding:7px 10px;border-right:2px solid var(--orange)}
body.touch-mode .kills-block{margin-right:54px}
body.touch-mode #perf-stats{top:59px}
@media(orientation:portrait) and (max-width:850px){body.touch-mode .weapon-panel{top:133px;right:9px;transform:scale(.82);transform-origin:top right}body.touch-mode .status-stack{top:133px;left:8px;transform:scale(.7);transform-origin:top left}body.touch-mode #rotate-hint{top:42%}}
</style>
</head>
<body>
<div id="loading"><div class="loading-mark">SHOTGUN <span>APOCALYPSE</span></div><div class="loadbar"><i id="load-progress"></i></div><div class="loadcopy" id="load-copy">BUILDING THE DEAD CITY</div></div>
<div id="vignette"></div><div id="grain"></div><div id="damage-flash"></div>
<div id="hud">
 <div class="hud-top"><div class="brand-mini">S/A <span>—</span> SURVIVAL PROTOCOL</div><div class="wave-block"><div class="wave-label">THREAT LEVEL</div><div class="wave-num" id="wave-num">01</div><div class="wave-sub" id="wave-state">WAVE INCOMING</div></div><div class="kills-block"><div class="kills-label">CONFIRMED KILLS</div><div class="kills-value" id="kills-value">000</div><div class="score-value" id="score-value">SCORE 000000</div></div></div>
 <div id="objective">ELIMINATE ALL HOSTILES</div><div id="perf-stats" aria-live="off">FPS — · <strong>AUTO</strong></div>
 <div id="crosshair"><i class="ch t"></i><i class="ch b"></i><i class="ch l"></i><i class="ch r"></i><i class="ch dot"></i></div>
 <div id="hitmarker"><i class="hm a"></i><i class="hm b"></i><i class="hm c"></i><i class="hm d"></i></div>
 <div id="toast"></div>
 <div class="hud-bottom"><div class="status-stack"><div class="stat-row"><div class="stat-icon">HP</div><div class="stat-info"><div class="stat-head"><span>VITAL SIGNS</span><b id="health-num">100</b></div><div class="bar"><i id="health-bar"></i></div></div></div><div class="stat-row"><div class="stat-icon">AR</div><div class="stat-info"><div class="stat-head"><span>ARMOR PLATING</span><b id="armor-num">050</b></div><div class="bar armor-bar"><i id="armor-bar"></i></div></div></div></div>
 <div class="weapon-panel"><div class="weapon-type" id="weapon-type">PUMP ACTION / 12 GA</div><div class="weapon-name" id="weapon-name">M870 BREACHER</div><div class="ammo-line"><span id="ammo-now">06</span> <small>/ <span id="ammo-reserve">042</span></small></div><div class="ammo-hint" id="ammo-hint">SHELLS LOADED · R TO RELOAD</div></div></div>
</div>
